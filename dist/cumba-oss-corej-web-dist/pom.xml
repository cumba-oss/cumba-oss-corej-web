<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.cumba</groupId>
        <artifactId>cumba-oss-corej-web-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>cumba-oss-corej-web-dist</artifactId>
    <packaging>pom</packaging>

    <name>Cumba OSS coreJ Web :: Distribution</name>
    <url>https://github.com/cumba-oss/cumba-oss-corej-web</url>
    <inceptionYear>2026</inceptionYear>
    <description>
        Shippable distribution of the validator SPA, as one release archive:

          cumba-oss-corej-web-&lt;version&gt;.zip   the built static site (index.html + assets/)

        The contents are produced into web/cumba-oss-corej-web/dist by that module's
        `vite build`, which the frontend-maven-plugin runs at verify. Nothing here is
        compiled; this module only packages.

        WHY A dist/ MODULE AND NOT A CLASSIFIER ON THE SPA MODULE.
        The release job's glob is `dist/*-dist/target/*.zip`. A zip attached as a
        classifier artifact to the web/ module would build correctly and then never be
        picked up, which is a silent failure. This module exists so the SPA reaches a
        release through the same machinery every other bundle uses.

        WHO CONSUMES IT. cumba-oss-clients' cumba-oss-cdisc-rest has a `bundle-web`
        profile taking -Dweb.dist.dir=/path/to/dist, which serves the UI from the API's
        own origin. Unzipping this archive produces exactly that directory, so bundling
        the UI needs no Node toolchain at all.

        ⛔ NOTHING HERE GOES TO MAVEN CENTRAL. This repository publishes no Maven
        artifacts at all; the SPA travels as a signed release asset.
    </description>

    <properties>
        <!-- The zip ships via the release, not as a Maven artifact. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!--
            ⚑ REACTOR EDGE, not a real dependency.

            This module's assembly reads web/cumba-oss-corej-web/dist by relative path. That
            directory is GENERATED by the SPA module's `vite build` and is not committed,
            so this module must not package before it. Maven orders the reactor by the
            dependency graph; without an edge two independent modules may build in any
            order — including concurrently under -T.

            <type>pom</type> because the SPA module is packaging=pom (it produces no jar);
            `provided` so nothing is dragged into the bundle.
        -->
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-corej-web</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                The built SPA must exist before the assembly copies it.

                ⚠ An assembly <fileSet> whose <directory> does not exist is SILENTLY
                skipped — the bundle builds green and ships EMPTY. Fail here instead,
                before the assembly runs, naming the cause.

                ⚠ index.html, not the directory: a stale, empty dist/ left by an
                interrupted build would satisfy a directory check and still ship nothing.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>require-built-spa</id>
                        <!--
                            VERIFY, not prepare-package. `vite build` runs at the SPA
                            module's verify phase, so at prepare-package the directory this
                            rule checks for does not exist yet and the rule would fail every
                            build. Declared BEFORE the assembly plugin below: executions
                            bound to the same phase run in POM plugin-declaration order, so
                            this still fails first, with a message, rather than letting the
                            assembly ship an empty zip.
                        -->
                        <phase>verify</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireFilesExist>
                                    <files>
                                        <file>${maven.multiModuleProjectDirectory}/web/cumba-oss-corej-web/dist/index.html</file>
                                    </files>
                                    <message>The built SPA is missing. It is produced by cumba-oss-corej-web's `vite build` into web/cumba-oss-corej-web/dist and is not committed. That runs at the VERIFY phase, so `mvn package` alone is not enough — build with `mvn verify`, e.g. mvn -pl dist/cumba-oss-corej-web-dist -am verify.</message>
                                </requireFilesExist>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                ⚠ Bound to VERIFY, not package.

                The SPA module produces dist/ from `npm run verify`, which its
                frontend-maven-plugin binds to the VERIFY phase. Maven runs each module's
                full lifecycle in turn, so under `mvn verify` the SPA module has already
                built dist/ by the time this module starts — but under `mvn package` the
                SPA's verify never runs at all, and this assembly would package nothing.
                Binding to verify means it cannot run ahead of the input it copies under
                any goal; the reactor edge above fixes which module goes first.

                ⚠ Consequence, stated plainly: `mvn package` produces NO zip here and no
                error. That is caught downstream by the release job's upload step, which
                sets if-no-files-found: error — and the enforcer message names `verify`.

                appendAssemblyId=false so the release glob gets the readable
                cumba-oss-corej-web-<version>.zip rather than a -dist suffix.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>make-web-dist</id>
                        <phase>verify</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <finalName>cumba-oss-corej-web-${project.version}</finalName>
                            <descriptors>
                                <descriptor>src/assembly/dist.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
