#################
#
# Primary .gitignore for cumba-oss-corej-web.
#
# ⚠ THIS RULE INVERTED WHEN THE REPO WAS FLATTENED. It previously said "DO NOT add a
#   bare dist/", because dist/ was a MAVEN MODULE DIRECTORY that had to be committed
#   while the SPA's vite output lived at web/cumba-oss-corej-web/dist.
#
#   There is one module now. dist/ is ONLY the vite output, and a bare rule is exactly
#   right. The Maven assembly descriptors live in assembly/, which IS committed —
#   do not ignore that one.
#
#################

# Vite build output — the release archive is assembled FROM this, never committed.
/dist/

# Node
node_modules/

# Maven
target/
.flattened-pom.xml

# Vitest coverage
coverage/

# Editors
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# OS-level cruft
.DS_Store

# Claude Code working dir
.claude

# .env files
.env
