<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        ============================================================
        cumba-oss-corej-web — the CDISC validator SPA.

        ⚠ THIS PARENT IS DELIBERATELY SLIM, and is the one OSS repo
        whose root pom is not the shared Java scaffold.

        Every other cumba-oss repo inherits a ~2000-line parent
        carrying the Java gate stack: PMD, SpotBugs, JaCoCo, Error
        Prone/NullAway, Lombok, the Eclipse formatter, Pitest and the
        Central publishing plugins, plus the five repo-root config
        files those read. THIS REPOSITORY CONTAINS NO JAVA AT ALL —
        one React/TypeScript module and an assembly — so all of that
        would be configuration that can never fire, and five config
        files a reader of a React repo would have to explain away.

        What replaced it: frontend-maven-plugin drives the npm gate
        chain (prettier + eslint + tsc + vitest + vite build), and
        Maven contributes only the pinned Node, the release assembly
        and ${revision}.

        ⚠ The frontend-maven-plugin block below stays near-identical
        to its monorepo twin, clients/corej-web, so a Phase 06c
        re-sync stays a near-copy: the skip-properties that twin sets
        for the internal parent's Java gates (spotbugs.skip, pmd.skip,
        jacoco.skip) are simply harmless no-ops here, because those
        plugins are not configured at all.
        ============================================================
    -->
    <groupId>net.cumba</groupId>
    <artifactId>cumba-oss-corej-web</artifactId>
    <packaging>pom</packaging>
    <version>${revision}</version>

    <properties>
        <general.encoding>UTF-8</general.encoding>
        <project.build.sourceEncoding>${general.encoding}</project.build.sourceEncoding>
        <project.build.reportEncoding>${general.encoding}</project.build.reportEncoding>

        <!-- project.basedir requires 3.9.12+ -->
        <maven.version>3.9.12</maven.version>
        <!-- revision should be set externally; this is just a fallback -->
        <revision>0.1.0-SNAPSHOT</revision>

        <!--
            ⛔ NOTHING IN THIS REPOSITORY IS PUBLISHED AS A MAVEN ARTIFACT —
            not to Maven Central, not to the internal Nexus. This is a single
            module with packaging=pom; the deliverable is the built SPA, shipped
            as a signed release archive (runbook Phase 06b). Set at the top of
            the file so any module added later inherits it rather than having to
            remember it.
        -->
        <maven.deploy.skip>true</maven.deploy.skip>

        <!-- Pinned to the same versions the other OSS repos use. -->
        <plugin.frontend-maven-plugin.version>2.0.2</plugin.frontend-maven-plugin.version>
        <plugin.maven-enforcer-plugin.version>3.6.3</plugin.maven-enforcer-plugin.version>
        <plugin.maven-assembly-plugin.version>3.8.0</plugin.maven-assembly-plugin.version>
        <plugin.flatten-maven-plugin.version>1.8.0</plugin.flatten-maven-plugin.version>
        <!-- ===== From the former SPA module pom. ===== -->
        <!--
            ⚠ INERT HERE, KEPT ON PURPOSE. This repository configures no Java
            gates at all (see the comment at the top of this file), so these
            skips suppress nothing. They are retained so this file stays a
            near-copy re-sync target against its monorepo twin,
            clients/corej-web, whose parent DOES bind PMD / SpotBugs / JaCoCo to
            every module and where they are load-bearing — that module ships no
            Java sources either, so the Java gates have nothing to analyse and
            actively fail or waste time on an empty source tree.

            Deleting them here would make every future Phase 06c sync a manual
            three-way merge to save four lines that cost nothing.
        -->
        <spotbugs.skip>true</spotbugs.skip>
        <pmd.skip>true</pmd.skip>
        <jacoco.skip>true</jacoco.skip>
        <!-- pom aggregator (the SPA build); nothing to publish. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>



    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.github.eirslett</groupId>
                    <artifactId>frontend-maven-plugin</artifactId>
                    <version>${plugin.frontend-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${plugin.maven-enforcer-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>${plugin.maven-assembly-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
                Enforce the Maven floor once, at the root. ${project.basedir} in a
                <requireFilesExist> message and the CI-friendly ${revision} handling
                below both need 3.9.12+.
            -->
            <!-- ⛔ DECLARATION ORDER IS LOAD-BEARING. frontend-maven-plugin, the enforcer and
                 the assembly are ALL bound to `verify`, and same-phase executions run in
                 the order their plugins are declared. `vite build` must therefore come
                 first, or the enforcer checks for a dist/ that does not exist yet and the
                 assembly would package nothing. In the old two-module layout the reactor
                 enforced this; here the file order is all there is. -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <configuration>
                    <nodeVersion>v24.20.0</nodeVersion>
                    <installDirectory>target</installDirectory>
                </configuration>
                <executions>
                    <!-- Install a pinned Node + npm under target/ (local dev). CI can
                         reuse a container Node by pointing nodeDownloadRoot/npmRegistryURL
                         at a mirror or skipping this execution when Node is on PATH.
                         Bound to initialize so Node + deps exist before gen:api: note
                         the Maven lifecycle runs generate-sources BEFORE generate-resources,
                         so the install/ci must precede generate-sources. -->
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <phase>initialize</phase>
                    </execution>
                    <!-- Reproducible install from the committed package-lock.json. -->
                    <execution>
                        <id>npm-ci</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>initialize</phase>
                        <configuration>
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>
                    <!-- Generate src/api/schema.d.ts from the committed openapi.snapshot.json,
                         or from a spec named explicitly via -Dopenapi.spec.file / OPENAPI_SPEC
                         (see scripts/gen-api.mjs).

                         `gen:api:check` is `gen:api` plus a `git diff` of the regenerated
                         file against the version git has, and fails the build when they
                         differ. Without it this generate-sources execution silently
                         overwrites the committed schema.d.ts on every build, leaving only
                         an unstaged diff nobody has to notice. Plain `npm run gen:api`,
                         without the check flag, keeps the rewrite behaviour and remains the
                         documented way to fix a reported drift.

                         ⚠ In the monorepo the other half of this guard was
                         OpenApiSnapshotDriftTest in clients/corej-rest, which pinned
                         the snapshot against the live spec. That test could not survive the
                         repo split and was removed from cumba-oss-clients — so within THIS
                         repo `gen:api:check` proves only that schema.d.ts matches the
                         committed snapshot, NOT that the snapshot matches the API. See the
                         README's "The API contract" section. -->
                    <execution>
                        <id>gen-api</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <arguments>run gen:api:check</arguments>
                        </configuration>
                    </execution>
                    <!-- Frontend quality gate: prettier-check + eslint + tsc + vitest coverage + vite build. -->
                    <execution>
                        <id>verify</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>verify</phase>
                        <configuration>
                            <arguments>run verify</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-maven</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[${maven.version},)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                
                        <!-- From the former dist module: the built SPA must exist before the
                             assembly copies it. Merged into THIS plugin element — two <plugin>
                             entries for one plugin is invalid and Maven only warns. -->
                    <execution>
                        <id>require-built-spa</id>
                        <!--
                            VERIFY, not prepare-package. `vite build` runs at the SPA
                            module's verify phase, so at prepare-package the directory this
                            rule checks for does not exist yet and the rule would fail every
                            build. Declared BEFORE the assembly plugin below: executions
                            bound to the same phase run in POM plugin-declaration order, so
                            this still fails first, with a message, rather than letting the
                            assembly ship an empty zip.
                        -->
                        <phase>verify</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireFilesExist>
                                    <files>
                                        <file>${project.basedir}/dist/index.html</file>
                                    </files>
                                    <message>The built SPA is missing. It is produced by cumba-oss-corej-web's `vite build` into dist and is not committed. That runs at the VERIFY phase, so `mvn package` alone is not enough — build with `mvn verify`, e.g. mvn verify.</message>
                                </requireFilesExist>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                ${revision} is a CI-friendly version placeholder. Without flatten the
                literal string "${revision}" would be written into any installed pom.
                resolveCiFriendliesOnly touches nothing else.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${plugin.flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
        
            <!-- ===== From the former web/ and dist/ module poms. SINGLE MODULE now:
                 the root pom IS the artifact. `vite build` and the assembly both run at
                 VERIFY, so their order is the PLUGIN DECLARATION ORDER below —
                 frontend first, then the enforcer, then the assembly. ===== -->

            
        
            <!--
                The built SPA must exist before the assembly copies it.

                ⚠ An assembly <fileSet> whose <directory> does not exist is SILENTLY
                skipped — the bundle builds green and ships EMPTY. Fail here instead,
                before the assembly runs, naming the cause.

                ⚠ index.html, not the directory: a stale, empty dist/ left by an
                interrupted build would satisfy a directory check and still ship nothing.
            -->
            

            <!--
                ⚠ Bound to VERIFY, not package.

                The SPA module produces dist/ from `npm run verify`, which its
                frontend-maven-plugin binds to the VERIFY phase. Maven runs each module's
                full lifecycle in turn, so under `mvn verify` the SPA module has already
                built dist/ by the time this module starts — but under `mvn package` the
                SPA's verify never runs at all, and this assembly would package nothing.
                Binding to verify means it cannot run ahead of the input it copies under
                any goal; the reactor edge above fixes which module goes first.

                ⚠ Consequence, stated plainly: `mvn package` produces NO zip here and no
                error. That is caught downstream by the release job's upload step, which
                sets if-no-files-found: error — and the enforcer message names `verify`.

                appendAssemblyId=false so the release glob gets the readable
                cumba-oss-corej-web-<version>.zip rather than a -dist suffix.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>make-web-dist</id>
                        <phase>verify</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <finalName>cumba-oss-corej-web-${project.version}</finalName>
                            <descriptors>
                                <descriptor>assembly/dist.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <name>Cumba OSS coreJ Web</name>
    <description>Single-page web UI (React + TypeScript + Vite) over the coreJ CDISC validation REST API.</description>
    <inceptionYear>2026</inceptionYear>
    <!--
        Points at the PUBLIC GitHub mirror, not the internal Gitea origin, because
        it must resolve for anyone reading the project. Nothing here reaches Maven
        Central, so these are good practice rather than a hard requirement
        (runbook Phase 06b) — they cost nothing and answer "where did this come
        from" for a reader of a release archive.
    -->
    <url child.project.url.inherit.append.path="false">https://github.com/cumba-oss/cumba-oss-corej-web</url>
    <organization>
        <name>P300</name>
        <url>https://www.p-300.com</url>
    </organization>

    <licenses>
        <license>
            <name>AGPL-3.0-only</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
            <distribution>repo</distribution>
            <comments>Licensed under the GNU Affero General Public License, version 3</comments>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Michael Weiss</name>
            <email>mw@p-300.com</email>
            <organization>P300</organization>
            <organizationUrl>https://www.p-300.com</organizationUrl>
        </developer>
    </developers>

    <scm child.scm.url.inherit.append.path="false"
         child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false">
        <connection>scm:git:https://github.com/cumba-oss/cumba-oss-corej-web.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/cumba-oss/cumba-oss-corej-web.git</developerConnection>
        <url>https://github.com/cumba-oss/cumba-oss-corej-web</url>
        <tag>HEAD</tag>
    </scm>

</project>
